{
  "name": "SleighHeistEngineTests",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "build/engine-src/shared"
      },
      "DevPackages": {
        "$path": "DevPackages"
      },
      "EngineTests": {
        "$path": "tests/engine"
      },
      "StudioTests": {
        "$path": "tests/studio"
      },
      "RunTests": {
        "$path": "tests/engine-support/RunTests.luau"
      },
      "CoverageProbes": {
        "$path": "tests/engine-support/CoverageProbes.luau"
      }
    },
    "ServerStorage": {
      "Server": {
        "$path": "build/engine-src/server"
      }
    },
    "ServerScriptService": {
      "$properties": {
        "LoadStringEnabled": true
      }
    }
  }
}
